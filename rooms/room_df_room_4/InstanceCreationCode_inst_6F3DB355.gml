empty_callback = function() {
    dialogue_start([
	"* (On second glance, you seem to have missed something)",
	"* (You got the {col(y)}FLOWSICLE{reset_col}!)",
	"{char(flow, 0)}* ...",
	"{char(flowcicle, 0)}* ...",
	"{char(flow, 1)}* ...",
	"{char(flowcicle, 0)}* ...",
	"{char(flow, 0)}* ...",
	"{char(flowcicle, 0)}* Sup?",
	"{char(none)}* (You threw the {col(y)}FLOWSICLE{reset_col} as hard as you could.)"
	])
}